---
const { frontmatter } = Astro.props;
// 自動截取乾淨日期（只保留 YYYY-MM-DD）
const cleanDate = frontmatter.pubDate ? String(frontmatter.pubDate).slice(0, 10) : '';
---
<!doctype html>
<html lang="zh-HK">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{frontmatter.title} | AI Never Late</title>
    <style is:global>
      :root {
        --bg-color: #0b0f19;
        --card-bg: rgba(17, 24, 39, 0.7);
        --accent-cyan: #00f2fe;
        --accent-orange: #ff7e40;
        --text-main: #f3f4f6;
        --text-sub: #9ca3af;
        --border-color: rgba(255, 255, 255, 0.08);
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
        background-color: var(--bg-color);
        background-image: 
          radial-gradient(ellipse at 80% 0%, rgba(255, 126, 64, 0.08) 0%, transparent 60%),
          radial-gradient(ellipse at 20% 10%, rgba(0, 242, 254, 0.08) 0%, transparent 60%);
        background-attachment: fixed;
        color: var(--text-main);
        line-height: 1.8;
      }

      .container {
        max-width: 820px;
        margin: 0 auto;
        padding: 40px 20px 100px;
      }

      /* 頂部導航與返回 */
      .back-nav {
        margin-bottom: 30px;
      }

      .back-link {
        color: var(--text-sub);
        text-decoration: none;
        font-size: 0.9rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: color 0.2s ease;
      }

      .back-link:hover {
        color: var(--accent-cyan);
      }

      /* 文章標題區 */
      .article-header {
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 24px;
        margin-bottom: 36px;
      }

      .article-title {
        font-size: 2.1rem;
        font-weight: 800;
        line-height: 1.3;
        margin-bottom: 16px;
        background: linear-gradient(135deg, #ffffff 40%, var(--accent-cyan) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .article-meta {
        color: var(--text-sub);
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
      }

      .tag-badge {
        background: rgba(0, 242, 254, 0.1);
        color: var(--accent-cyan);
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.75rem;
        border: 1px solid rgba(0, 242, 254, 0.2);
      }

      /* 正文排版優化 (支援所有 Markdown 標籤) */
      article h2 {
        font-size: 1.45rem;
        color: #ffffff;
        margin-top: 40px;
        margin-bottom: 16px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
      }

      article h2::before {
        content: "▌";
        color: var(--accent-cyan);
        margin-right: 8px;
        font-size: 1.1rem;
      }

      article h3 {
        font-size: 1.2rem;
        color: var(--accent-orange);
        margin-top: 28px;
        margin-bottom: 12px;
      }

      article p {
        color: #d1d5db;
        margin-bottom: 20px;
        font-size: 1.05rem;
      }

      article a {
        color: var(--accent-cyan);
        text-decoration: underline;
        text-underline-offset: 4px;
      }

      article a:hover {
        color: #38ef7d;
      }

      article strong {
        color: #ffffff;
      }

      article ul, article ol {
        color: #d1d5db;
        padding-left: 24px;
        margin-bottom: 24px;
      }

      article li {
        margin-bottom: 8px;
      }

      /* 程式碼區塊 (Code Blocks) */
      article pre {
        background: #060911 !important;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 18px;
        overflow-x: auto;
        margin: 24px 0;
        box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.6);
      }

      article code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.9em;
      }

      /* 表格樣式 */
      article table {
        width: 100%;
        border-collapse: collapse;
        margin: 28px 0;
        background: var(--card-bg);
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid var(--border-color);
      }

      article th, article td {
        padding: 12px 16px;
        text-align: left;
        border-bottom: 1px solid var(--border-color);
      }

      article th {
        background: rgba(255, 255, 255, 0.04);
        color: var(--accent-cyan);
        font-weight: 600;
      }

      /* 引用區塊 (Blockquote) */
      article blockquote {
        margin: 24px 0;
        padding: 12px 20px;
        background: rgba(0, 242, 254, 0.04);
        border-left: 3px solid var(--accent-cyan);
        border-radius: 0 8px 8px 0;
        color: var(--text-sub);
      }
    </style>
  </head>
  <body>
    <div class="container">
      <!-- 頂部返回 -->
      <nav class="back-nav">
        <a href="/" class="back-link">← 返回首頁</a>
      </nav>

      <!-- 文章 Header -->
      <header class="article-header">
        <h1 class="article-title">{frontmatter.title}</h1>
        <div class="article-meta">
          <span>📅 發布日期：{cleanDate}</span>
          {frontmatter.tags && frontmatter.tags.map((tag: string) => (
            <span class="tag-badge">#{tag}</span>
          ))}
        </div>
      </header>

      <!-- Markdown 正文插槽 -->
      <article>
        <slot />
      </article>
    </div>
  </body>
</html>