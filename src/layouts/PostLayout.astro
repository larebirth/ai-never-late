---
import '../site.css';
const { frontmatter } = Astro.props;
const date = String(frontmatter.pubDate || '').slice(0,10).replaceAll('-', '.');
const headings = Astro.props.headings || [];
const sections = headings.filter(heading => heading.depth === 2);
---
<!doctype html><html lang="zh-HK"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={frontmatter.description || ''} /><title>{frontmatter.title} | AI Never Late</title></head>
<body><header class="site-header shell"><a href="/" class="brand"><img src="/logo.png" alt="" width="36" height="36" /><span>AI NEVER LATE<span class="accent">.</span></span></a><nav aria-label="主導航"><a href="/#research">研究筆記 ↗</a></nav></header>
<main class="shell article-page"><a href="/#research" class="back-link">← 返回研究筆記</a><header class="article-header"><p class="eyebrow">● &nbsp; THE RESEARCH LOG</p><div class="post-tags">{frontmatter.tags?.map(tag => <span>{tag}</span>)}</div><h1>{frontmatter.title}</h1>{frontmatter.description && <p class="article-description">{frontmatter.description}</p>}<div class="article-meta"><time class="mono">{date}</time><span>AI Never Late · 研究筆記</span></div></header>
<div class="article-grid"><aside class="article-aside"><p class="eyebrow">IN THIS NOTE</p>{sections.length ? <nav aria-label="文章目錄">{sections.map(section => <a href={`#${section.slug}`}>{section.text}</a>)}</nav> : <p>一個想法，<br />通往下一次探索。</p>}<div class="aside-mark" aria-hidden="true">↗</div><span class="mono">KEEP EXPLORING</span></aside><div class="article-main"><article class="prose"><slot /></article><div class="article-end"><p class="eyebrow">END OF NOTE</p><p>每一次探索，都是新的起點。</p><a href="/#research" class="primary-link">繼續探索 <span>↗</span></a></div></div></div></main><footer class="site-footer shell"><span>AI NEVER LATE<span class="accent">.</span></span><p>保持好奇，繼續探索。</p><span class="mono">© {new Date().getFullYear()}</span></footer></body></html>
