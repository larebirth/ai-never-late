---
// 1. Astro 的 JavaScript 變數必須全部集中在頂部的三條橫線內
const posts = await Astro.glob('./posts/*.md');
---
<!doctype html>
<html lang="zh-HK">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AI Never Late | AI 研究筆記與個人里程碑</title>
    <style>
      :root {
        --bg-color: #0b0f19;
        --card-bg: rgba(17, 24, 39, 0.7);
        --accent-cyan: #00f2fe;
        --accent-orange: #ff7e40;
        --text-main: #f3f4f6;
        --text-sub: #9ca3af;
        --border-color: rgba(255, 255, 255, 0.08);
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
        background-color: var(--bg-color);
        background-image: 
          radial-gradient(ellipse at 80% 0%, rgba(255, 126, 64, 0.12) 0%, transparent 60%),
          radial-gradient(ellipse at 20% 10%, rgba(0, 242, 254, 0.12) 0%, transparent 60%);
        background-attachment: fixed;
        color: var(--text-main);
        min-height: 100vh;
        line-height: 1.6;
      }

      /* 頂部導航欄（低調 CMS 入口） */
      header {
        max-width: 900px;
        margin: 0 auto;
        padding: 24px 20px 0;
        display: flex;
        justify-content: flex-end;
      }

      .admin-link {
        font-size: 0.8rem;
        color: var(--text-sub);
        text-decoration: none;
        padding: 6px 12px;
        border-radius: 20px;
        border: 1px solid var(--border-color);
        background: rgba(255, 255, 255, 0.03);
        transition: all 0.2s ease;
      }

      .admin-link:hover {
        color: var(--accent-cyan);
        border-color: rgba(0, 242, 254, 0.4);
        background: rgba(0, 242, 254, 0.08);
      }

      /* Hero 區域（Logo + 標題） */
      .hero {
        max-width: 900px;
        margin: 20px auto 40px;
        padding: 0 20px;
        display: flex;
        align-items: center;
        gap: 28px;
      }

      .logo-img {
        width: 110px;
        height: 110px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 0 25px rgba(0, 242, 254, 0.25), 0 0 15px rgba(255, 126, 64, 0.25);
        border: 2px solid rgba(255, 255, 255, 0.15);
      }

      .hero-content h1 {
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -0.5px;
        background: linear-gradient(135deg, #ffffff 30%, var(--accent-cyan) 80%, var(--accent-orange) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 6px;
      }

      .hero-content p {
        color: var(--text-sub);
        font-size: 0.95rem;
      }

      /* 文章列表卡片 */
      main {
        max-width: 900px;
        margin: 0 auto;
        padding: 0 20px 80px;
      }

      .section-title {
        font-size: 1.1rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: var(--accent-cyan);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .section-title::after {
        content: "";
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, var(--border-color), transparent);
      }

      .posts-grid {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .post-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 22px;
        backdrop-filter: blur(8px);
        text-decoration: none;
        color: inherit;
        display: block;
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        position: relative;
        overflow: hidden;
      }

      .post-card::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 3px;
        background: linear-gradient(to bottom, var(--accent-cyan), var(--accent-orange));
        opacity: 0;
        transition: opacity 0.25s ease;
      }

      .post-card:hover {
        transform: translateY(-2px);
        border-color: rgba(0, 242, 254, 0.3);
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
      }

      .post-card:hover::before {
        opacity: 1;
      }

      .post-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 8px;
        transition: color 0.2s ease;
      }

      .post-card:hover .post-title {
        color: var(--accent-cyan);
      }

      .post-desc {
        color: var(--text-sub);
        font-size: 0.95rem;
        margin-bottom: 14px;
        line-height: 1.5;
      }

      .post-meta {
        font-size: 0.8rem;
        color: #6b7280;
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
      }

      .tag {
        background: rgba(0, 242, 254, 0.08);
        color: var(--accent-cyan);
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.75rem;
      }

      @media (max-width: 600px) {
        .hero { flex-direction: column; text-align: center; }
        .hero-content h1 { font-size: 1.6rem; }
      }
    </style>
  </head>
  <body>
    <!-- 右上角低調的 CMS 後台按鈕 -->
    <header>
      <a href="/admin/" class="admin-link">⚙ 管理後台</a>
    </header>

    <!-- 品牌 Hero 區域 -->
    <div class="hero">
      <img src="/logo.png" alt="AI Never Late" class="logo-img" onerror="this.style.display='none'" />
      <div class="hero-content">
        <h1>AI Never Late</h1>
        <p>探索前沿 AI 浪潮 · 記錄實踐與研究里程碑</p>
      </div>
    </div>

    <!-- 主體文章列表 -->
    <main>
      <div class="section-title">最新研究文章</div>
      <div class="posts-grid">
        {posts.map(post => (
          <a href={post.url} class="post-card">
            <h2 class="post-title">{post.frontmatter.title}</h2>
            <p class="post-desc">{post.frontmatter.description}</p>
            <div class="post-meta">
              <span>{post.frontmatter.pubDate?.slice(0, 10)}</span>
              {post.frontmatter.tags && post.frontmatter.tags.map((tag: string) => (
                <span class="tag">#{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </main>
  </body>
</html>