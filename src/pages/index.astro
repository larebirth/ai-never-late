<main class="container">
  <!-- 英雄區塊與標誌 -->
  <section class="hero">
    <div class="hero-logo-wrapper">
      <img src="/logo.png" alt="AI NEVER LATE Logo" class="hero-logo" />
    </div>
    <h1 class="hero-title">AI NEVER LATE</h1>
    <p class="hero-subtitle">前沿人工智能研究、實測記錄與個人里程碑</p>
  </section>

  <!-- 文章動態清單 -->
  <section>
    <div class="section-header">
      <span class="section-badge">Latest</span>
      <h2 class="section-title">研究與技術發布</h2>
    </div>

    <div class="posts-grid">
      {posts.map((post) => (
        <a href={post.url} class="post-card">
          <h3 class="post-title">{post.frontmatter.title}</h3>
          <p class="post-desc">{post.frontmatter.description}</p>
          <div class="post-meta">
            <span class="post-date">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="18" y2="10"></line>
              </svg>
              {formatDate(post.frontmatter.pubDate)}
            </span>
            {post.frontmatter.tags && post.frontmatter.tags.length > 0 && (
              <div class="post-tags">
                {post.frontmatter.tags.map((tag: string) => (
                  <span class="tag-pill">{tag}</span>
                ))}
              </div>
            )}
          </div>
        </a>
      ))}
    </div>
  </section>

  <footer>
    <p>© 2026 AI NEVER LATE · Powered by Astro & Cloudflare Pages</p>
  </footer>
</main>
