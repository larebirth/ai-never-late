---
import '../site.css';
const posts = (await Astro.glob('./posts/*.md')).sort((a,b) => String(b.frontmatter.pubDate).localeCompare(String(a.frontmatter.pubDate)) || b.url.localeCompare(a.url));
const featured = posts[0];
const tags = [...new Set(posts.flatMap(p => p.frontmatter.tags || []))];
const date = value => String(value || '').slice(0,10).replaceAll('-', '.');
---
<!doctype html>
<html lang="zh-HK">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content="探索前沿 AI 浪潮，記錄實踐、研究與每一次突破。" /><title>AI Never Late | 探索，永遠不遲</title></head>
<body>
<header class="site-header shell"><a href="/" class="brand"><img src="/logo.png" alt="" width="36" height="36" /><span>AI NEVER LATE<span class="accent">.</span></span></a><nav aria-label="主導航"><a href="#research">研究筆記 ↗</a><a href="/admin/" class="admin-link">管理後台</a></nav></header>
<main class="shell">
<section class="hero hero-with-image"><picture class="hero-art" aria-hidden="true"><source media="(min-width: 701px)" srcset="/future-hero.png" /><img src="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%271%27 height=%271%27/%3E" alt="" width="1672" height="941" fetchpriority="high" /></picture><div class="hero-copy"><p class="eyebrow">● &nbsp; NOTES FROM THE NEXT WAVE</p><h1>探索未來。<br /><span class="accent">永遠不遲。</span></h1><p class="hero-description">AI 的下一步，從每一次好奇開始。<br />在這裡，記錄研究、實踐，以及思考的軌跡。</p><a class="primary-link" href="#research">探索研究筆記 <span>↗</span></a><div class="hero-meta"><span>獨立探索 · 持續進化</span><span class="mono">EST. 2026</span></div></div><div class="signal" aria-hidden="true"><div class="signal-grid"></div><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><div class="signal-core"><span>AI</span><small>NEVER LATE</small></div><span class="signal-label label-top">HUMAN CURIOSITY</span><span class="signal-label label-bottom">ENDLESS POSSIBILITIES</span><span class="signal-number">01 — ∞</span></div></section>
<section id="research" class="research-section"><div class="section-heading"><div><p class="eyebrow">THE RESEARCH LOG</p><h2>研究與實踐</h2></div><span class="mono section-count">{String(posts.length).padStart(2,'0')} ENTRIES</span></div><div class="topic-strip"><span class="topic-label">探索領域</span>{tags.map(tag => <span class="topic">{tag}</span>)}</div>
{featured && <a href={featured.url} class="featured-card"><div class="featured-visual" aria-hidden="true"><div class="visual-lines"></div><span class="visual-caption mono">IDEAS → EXPERIMENTS → INSIGHTS</span><span class="visual-glyph">↗</span><span class="visual-bottom mono">AI / NEVER / LATE</span></div><div class="featured-content"><p class="eyebrow">● &nbsp; FEATURED NOTE</p><div class="post-tags">{featured.frontmatter.tags?.map(tag => <span>{tag}</span>)}</div><h3>{featured.frontmatter.title}</h3><p class="card-description">{featured.frontmatter.description}</p><div class="card-bottom"><time class="mono">{date(featured.frontmatter.pubDate)}</time><span>閱讀筆記 &nbsp; ↗</span></div></div></a>}
<div class="posts-grid">{posts.slice(1).map((post,index) => <a href={post.url} class="post-card"><div class="card-top"><span class="mono">/ {String(index+2).padStart(2,'0')}</span><span class="arrow">↗</span></div><div class="post-tags">{post.frontmatter.tags?.map(tag => <span>{tag}</span>)}</div><h3>{post.frontmatter.title}</h3><p class="card-description">{post.frontmatter.description}</p><div class="card-bottom"><time class="mono">{date(post.frontmatter.pubDate)}</time><span>閱讀筆記</span></div></a>)}</div></section>
</main><footer class="site-footer shell"><span>AI NEVER LATE<span class="accent">.</span></span><p>保持好奇，繼續探索。</p><span class="mono">© {new Date().getFullYear()}</span></footer>
</body></html>
